# Copy to .env. The app runs with no keys using the mock STT and browser TTS.
LLM_PROVIDER=rules
STT_PROVIDER=mock
TTS_PROVIDER=browser
STORE_AUDIO=false
TZ=Asia/Kolkata

# Gnani Voice Services (Prisma STT and Timbre TTS)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# Gnani STT (Prisma) settings
# Model: empty for Prisma v2.5, or "prisma-v3.0"
GNANI_STT_MODEL=
GNANI_STT_LANGUAGES=bn-IN
# Format: empty for service default (or "verbatim", "transcribe", "codemix")
GNANI_STT_FORMAT=
# Context: optional topic and keyterms (JSON array string, e.g. ["ANC", "টিকা"])
GNANI_STT_TOPIC=
GNANI_STT_KEYTERMS=

# Gnani TTS (Timbre) settings
# Model: "timbre-v3.0" or "timbre-v2.5"
GNANI_TTS_MODEL=timbre-v3.0
# Voice: e.g. "Shivani", "Riyaa", "Kalpana", "Chetana", "Devansh"
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=bn-IN
GNANI_TTS_SPEED=1.0
GNANI_TTS_CONTAINER=mp3
GNANI_TTS_SAMPLE_RATE=24000
GNANI_TTS_SPOKEN_NUMBERS=true

# Concurrency, timeout, and cache
GNANI_MAX_CONCURRENCY=1
GNANI_TIMEOUT_S=30
TTS_CACHE_DIR=.cache/tts
